# Copy this file to ".env" and fill in the values.
# Every variable here is validated at startup by src/env.js.
# Run with SKIP_ENV_VALIDATION=1 to bypass validation (e.g. Docker builds).

# --- Auth.js ---------------------------------------------------------------
# Generate with: npx auth secret
AUTH_SECRET=""

# --- Database (PostgreSQL) -------------------------------------------------
# Local:  postgresql://<user>@localhost:5432/ai_podcast_clipper
# Hosted: Neon / Supabase / Railway connection string
DATABASE_URL=""

# --- AWS S3 ----------------------------------------------------------------
# IAM user with Get/Put/List permissions on the bucket (see README)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
S3_BUCKET_NAME="ai-podcast-clipper"

# --- Modal backend ---------------------------------------------------------
# URL printed by `modal deploy main.py` (ends in ...process-video.modal.run)
PROCESS_VIDEO_ENDPOINT=""
# Must equal AUTH_TOKEN in the Modal secret "ai-podcast-clipper-secret"
PROCESS_VIDEO_ENDPOINT_AUTH=""

# --- Stripe ----------------------------------------------------------------
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# Price IDs of three one-time products (50 / 150 / 500 credits)
STRIPE_SMALL_CREDIT_PACK="price_..."
STRIPE_MEDIUM_CREDIT_PACK="price_..."
STRIPE_LARGE_CREDIT_PACK="price_..."
# Printed by: stripe listen --forward-to localhost:3000/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET="whsec_..."

# --- App -------------------------------------------------------------------
# Used for Stripe checkout redirect URLs
BASE_URL="http://localhost:3000"
